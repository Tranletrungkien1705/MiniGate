@model List<ApiClient>
@{ ViewData["Title"] = "Client & API key"; }
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-key me-2"></i>Cấp key cho client</h6>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên client (VD: Mobile App)" required /></div>
            <div class="mb-3"><label class="form-label small text-muted">Hạn mức (req/phút)</label><input name="rateLimit" type="number" value="60" class="form-control" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Cấp API key</button>
        </form>
        <p class="text-muted small mt-3 mb-0">Client gửi key qua header <code>X-Api-Key</code> khi gọi <code>/gw/...</code>.</p>
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle">
            <thead><tr><th>Client</th><th>API key</th><th>Hạn mức</th><th>TT</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-semibold">@c.Name</td>
                    <td><code class="small">@c.ApiKey</code></td>
                    <td>@c.RateLimitPerMin/phút</td>
                    <td>@if (c.IsActive) { <span class="badge bg-success">bật</span> } else { <span class="badge bg-secondary">tắt</span> }</td>
                    <td><form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><button class="btn btn-sm btn-outline-secondary">@(c.IsActive ? "Tắt" : "Bật")</button></form></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có client.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
</div>
