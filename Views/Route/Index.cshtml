@model List<GwRoute>
@{ ViewData["Title"] = "Tuyến (Routes)"; }
<div class="row g-3">
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-plus-square me-2"></i>Thêm tuyến</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="0" />
            <div class="mb-2"><label class="form-label small text-muted">Tên</label><input name="name" class="form-control" placeholder="VD: Product Center" required /></div>
            <div class="mb-2"><label class="form-label small text-muted">Prefix (/gw/<b>prefix</b>/...)</label><input name="prefix" class="form-control" placeholder="pim" required /></div>
            <div class="mb-2"><label class="form-label small text-muted">Upstream URL</label><input name="upstreamBaseUrl" class="form-control" placeholder="https://minipim.onrender.com" required /></div>
            <div class="row g-2 mb-3">
                <div class="col-6"><label class="form-label small text-muted">Timeout (s)</label><input name="timeoutSeconds" type="number" value="30" class="form-control" /></div>
                <div class="col-6 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="requireAuth" value="true" id="ra" /><label class="form-check-label small" for="ra">Yêu cầu API key</label></div></div>
            </div>
            <button class="btn btn-primary w-100"><i class="bi bi-check-lg me-1"></i>Lưu tuyến</button>
        </form>
    </div></div></div>
    <div class="col-lg-7"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Các tuyến</h6>
        <table class="table table-hover align-middle">
            <thead><tr><th>Prefix</th><th>Tên → Upstream</th><th>Auth</th><th>TT</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><code>/gw/@r.Prefix</code></td>
                    <td><div class="fw-semibold">@r.Name</div><div class="small text-muted text-truncate" style="max-width:240px">@r.UpstreamBaseUrl</div></td>
                    <td>@if (r.RequireAuth) { <span class="badge bg-warning text-dark">key</span> } else { <span class="badge bg-light text-muted">mở</span> }</td>
                    <td>@if (r.IsActive) { <span class="badge bg-success">bật</span> } else { <span class="badge bg-secondary">tắt</span> }</td>
                    <td><form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-outline-secondary">@(r.IsActive ? "Tắt" : "Bật")</button></form></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có tuyến.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
</div>
