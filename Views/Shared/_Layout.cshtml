@{
    string Nav(string c) => (ViewContext.RouteData.Values["controller"]?.ToString() == c) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MiniGate</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --accent:#059669; --accent2:#047857; --sidebar:#0f172a; }
        body { font-size:14px; background:#f1f5f4; font-family:"Be Vietnam Pro",sans-serif; -webkit-font-smoothing:antialiased; }
        .sidebar { width:236px; min-height:100vh; background:var(--sidebar); flex-shrink:0; }
        .sidebar .brand { color:#fff; font-weight:800; font-size:18px; padding:20px 18px 12px; display:flex; align-items:center; gap:9px; }
        .sidebar .brand span { color:#6ee7b7; }
        .sidebar .nav-link { color:#94a3b8; padding:9px 18px; display:flex; align-items:center; gap:10px; font-size:14px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color:#fff; background:rgba(5,150,105,.28); border-left:3px solid var(--accent); }
        .sidebar .nav-section { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#475569; padding:14px 18px 4px; }
        .topbar { background:#fff; border-bottom:1px solid #e3e9e8; padding:11px 24px; }
        .content-area { padding:24px; }
        .card { border:none; box-shadow:0 1px 4px rgba(2,20,15,.07); border-radius:13px; }
        .btn-primary { background:var(--accent); border-color:var(--accent); } .btn-primary:hover { background:var(--accent2); border-color:var(--accent2); }
        .btn-outline-primary { color:var(--accent); border-color:var(--accent); } .btn-outline-primary:hover { background:var(--accent); color:#fff; }
        a { color:var(--accent2); }
        table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:#6b7280; border-bottom:2px solid #e5e7eb; }
        .stat-num { font-size:26px; font-weight:800; }
        code { color:#0f766e; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-hdd-network"></i> Mini<span>Gate</span></div>
        <div class="mt-1">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link @(Nav("Home"))" href="/"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
            <a class="nav-link @(Nav("Log"))" href="/Log"><i class="bi bi-list-columns-reverse"></i> Nhật ký request</a>
            <div class="nav-section">Cấu hình</div>
            <a class="nav-link @(Nav("Route"))" href="/Route"><i class="bi bi-signpost-split"></i> Tuyến (Routes)</a>
            <a class="nav-link @(Nav("Client"))" href="/Client"><i class="bi bi-key"></i> Client &amp; API key</a>
            <a class="nav-link @(Nav("Playground"))" href="/Playground"><i class="bi bi-play-circle"></i> Thử cổng</a>
            <div class="nav-section">Hệ thống</div>
            <a class="nav-link @(Nav("Org"))" href="/Org"><i class="bi bi-diagram-3"></i> Tổ chức</a>
        </div>
        <div class="mt-auto p-3" style="color:#475569;font-size:11px">API Gateway · định tuyến · rate limit · demo</div>
    </nav>
    <div class="main-content flex-fill" style="overflow-x:hidden">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <a href="/Org" class="text-muted small text-decoration-none"><i class="bi bi-building me-1"></i>@(Context.Request.Cookies["org_name"] ?? "Demo Gate")</a>
        </div>
        <div class="content-area">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
