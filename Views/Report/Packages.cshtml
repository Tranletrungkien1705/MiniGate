@model InosPackageListResult
@{ ViewData["Title"] = "Danh sách gói dịch vụ"; }
<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-box-seam me-1"></i>Danh sách gói dịch vụ (OS_Inos_Package)</h6>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-3"><label class="form-label small mb-1">Tên gói (Name)</label><input name="name" value="@ViewBag.Name" class="form-control form-control-sm" placeholder="VD: Gói" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Loại license</label><input name="licenseType" value="@ViewBag.LicenseType" class="form-control form-control-sm" placeholder="VD: YEAR" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Chiết khấu</label>
            <select name="isDiscountable" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.IsDiscountable as string))">Tất cả</option>
                <option value="1" selected="@(ViewBag.IsDiscountable == "1")">Cho phép</option>
                <option value="0" selected="@(ViewBag.IsDiscountable == "0")">Không</option>
            </select>
        </div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Trạng thái</label>
            <select name="flagActive" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.FlagActive as string))">Tất cả</option>
                <option value="1" selected="@(ViewBag.FlagActive == "1")">Đang hoạt động</option>
                <option value="0" selected="@(ViewBag.FlagActive == "0")">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-6 col-md-1"><label class="form-label small mb-1">Số/trang</label><input type="number" name="recordCount" value="@ViewBag.RecordCount" class="form-control form-control-sm" min="1" /></div>
        <div class="col-12 col-md-2"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Xem</button></div>
    </form>
</div></div>
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Danh sách gói dịch vụ</h6>
        <span class="text-muted small">@Model.TotalCount bản ghi · trang bắt đầu @Model.RecordStart</span>
    </div>
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Mã gói</th>
                <th>Tên gói</th>
                <th>Loại license</th>
                <th>Kỳ thuê bao</th>
                <th class="text-end">Giá</th>
                <th class="text-center">Chiết khấu</th>
                <th class="text-center">Trạng thái</th>
                <th>Cập nhật cuối</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="text-muted small">@r.Idx</td>
                <td class="fw-semibold" style="font-family:monospace">@r.PackageId</td>
                <td>@r.Name<div class="text-muted small">@r.Description</div></td>
                <td>@r.LicenseType</td>
                <td>@r.Subscription</td>
                <td class="text-end">@r.Price.ToString("N0")</td>
                <td class="text-center">
                    @if (r.IsDiscountable) { <span class="badge" style="background:#059669">Có</span> }
                    else { <span class="badge bg-secondary">Không</span> }
                </td>
                <td class="text-center">
                    @if (r.FlagActive) { <span class="badge" style="background:#059669">Đang hoạt động</span> }
                    else { <span class="badge bg-secondary">Ngừng hoạt động</span> }
                </td>
                <td class="small">@r.LogLUDTimeUTC.ToString("yyyy-MM-dd HH:mm")<div class="text-muted small">@r.LogLUBy</div></td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">Không có gói dịch vụ nào khớp bộ lọc.</td></tr> }
        </tbody>
    </table>
    </div>
    <p class="text-muted small mb-0 mt-2">
        <i class="bi bi-info-circle me-1"></i>Endpoint tổng hợp: trả về danh mục gói dịch vụ (OS_Inos_Package), có phân trang + lọc theo tên gói / loại license / cờ chiết khấu / trạng thái.
    </p>
</div></div>
