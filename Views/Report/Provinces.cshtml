@model ProvinceListResult
@{ ViewData["Title"] = "Danh sách tỉnh/thành"; }
<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-geo-alt me-1"></i>Danh sách tỉnh/thành (Mst_Province)</h6>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-3"><label class="form-label small mb-1">Mã tỉnh (ProvinceCode)</label><input name="provinceCode" value="@ViewBag.ProvinceCode" class="form-control form-control-sm" placeholder="VD: 01" /></div>
        <div class="col-6 col-md-3"><label class="form-label small mb-1">Tên tỉnh (ProvinceName)</label><input name="provinceName" value="@ViewBag.ProvinceName" class="form-control form-control-sm" placeholder="VD: Hà Nội" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Trạng thái</label>
            <select name="flagActive" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.FlagActive as string))">Tất cả</option>
                <option value="1" selected="@(ViewBag.FlagActive == "1")">Đang hoạt động</option>
                <option value="0" selected="@(ViewBag.FlagActive == "0")">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-6 col-md-1"><label class="form-label small mb-1">Số/trang</label><input type="number" name="recordCount" value="@ViewBag.RecordCount" class="form-control form-control-sm" min="1" /></div>
        <div class="col-12 col-md-2"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Xem</button></div>
    </form>
</div></div>
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Danh sách tỉnh/thành</h6>
        <span class="text-muted small">@Model.TotalCount bản ghi · trang bắt đầu @Model.RecordStart</span>
    </div>
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Mã tỉnh</th>
                <th>Tên tỉnh/thành</th>
                <th class="text-center">Trạng thái</th>
                <th>Cập nhật cuối</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="text-muted small">@r.Idx</td>
                <td class="fw-semibold" style="font-family:monospace">@r.ProvinceCode</td>
                <td>@r.ProvinceName</td>
                <td class="text-center">
                    @if (r.FlagActive) { <span class="badge" style="background:#059669">Đang hoạt động</span> }
                    else { <span class="badge bg-secondary">Ngừng hoạt động</span> }
                </td>
                <td class="small">@r.LogLUDTimeUTC.ToString("yyyy-MM-dd HH:mm")<div class="text-muted small">@r.LogLUBy</div></td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Không có tỉnh/thành nào khớp bộ lọc.</td></tr> }
        </tbody>
    </table>
    </div>
    <p class="text-muted small mb-0 mt-2">
        <i class="bi bi-info-circle me-1"></i>Endpoint tổng hợp: trả về danh mục tỉnh/thành (Mst_Province), có phân trang + lọc theo mã tỉnh / tên tỉnh / trạng thái.
    </p>
</div></div>