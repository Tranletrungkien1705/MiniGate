@model NntTypeListResult
@{ ViewData["Title"] = "Danh sách loại người nộp thuế"; }
<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-person-vcard me-1"></i>Danh sách loại người nộp thuế (RptSv_Mst_NNTType)</h6>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-3"><label class="form-label small mb-1">Mã loại NNT (NNTType)</label><input name="nntType" value="@ViewBag.NNTType" class="form-control form-control-sm" placeholder="VD: ORG" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Trạng thái</label>
            <select name="flagActive" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.FlagActive as string))">Tất cả</option>
                <option value="1" selected="@(ViewBag.FlagActive == "1")">Đang hoạt động</option>
                <option value="0" selected="@(ViewBag.FlagActive == "0")">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-6 col-md-1"><label class="form-label small mb-1">Số/trang</label><input type="number" name="recordCount" value="@ViewBag.RecordCount" class="form-control form-control-sm" min="1" /></div>
        <div class="col-12 col-md-2"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Xem</button></div>
    </form>
</div></div>

<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Danh sách loại người nộp thuế</h6>
        <span class="text-muted small">@Model.TotalCount bản ghi · trang bắt đầu @Model.RecordStart</span>
    </div>
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Mã loại NNT</th>
                <th>Tên loại người nộp thuế</th>
                <th class="text-center">Trạng thái</th>
                <th>Cập nhật cuối</th>
                <th>Người cập nhật</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="text-muted small">@r.Idx</td>
                <td class="fw-semibold" style="font-family:monospace">@r.NNTType</td>
                <td>@r.NNTTypeName</td>
                <td class="text-center">
                    @if (r.FlagActive) { <span class="badge" style="background:#059669">Đang hoạt động</span> }
                    else { <span class="badge bg-secondary">Ngừng hoạt động</span> }
                </td>
                <td class="small">@r.LogLUDTimeUTC.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="small">@(string.IsNullOrEmpty(r.LogLUBy) ? "—" : r.LogLUBy)</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Không có loại người nộp thuế nào khớp bộ lọc.</td></tr> }
        </tbody>
    </table>
    </div>
    <p class="text-muted small mb-0 mt-2">
        <i class="bi bi-info-circle me-1"></i>Endpoint tổng hợp: trả về danh mục loại người nộp thuế (Mst_NNTType) kèm mã/tên/trạng thái, có phân trang + lọc theo mã loại NNT / trạng thái.
    </p>
</div></div>