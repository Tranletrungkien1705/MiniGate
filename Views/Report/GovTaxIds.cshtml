@model GovTaxIdListResult
@{ ViewData["Title"] = "Danh sách cơ quan thuế"; }
<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-bank me-1"></i>Danh sách cơ quan thuế (Mst_GovTaxID)</h6>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mã cơ quan thuế</label><input name="govTaxId" value="@ViewBag.GovTaxID" class="form-control form-control-sm" placeholder="VD: CQT-HN" /></div>
        <div class="col-6 col-md-3"><label class="form-label small mb-1">Tên cơ quan thuế</label><input name="govTaxName" value="@ViewBag.GovTaxName" class="form-control form-control-sm" placeholder="VD: Cục Thuế" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mạng/đại lý (NetworkID)</label><input name="networkId" value="@ViewBag.NetworkID" class="form-control form-control-sm" placeholder="VD: NET-DEMO" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mã tỉnh (ProvinceCode)</label><input name="provinceCode" value="@ViewBag.ProvinceCode" class="form-control form-control-sm" placeholder="VD: 01" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Trạng thái</label>
            <select name="flagActive" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.FlagActive as string))">Tất cả</option>
                <option value="1" selected="@(ViewBag.FlagActive == "1")">Đang hoạt động</option>
                <option value="0" selected="@(ViewBag.FlagActive == "0")">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-6 col-md-1"><label class="form-label small mb-1">Số/trang</label><input type="number" name="recordCount" value="@ViewBag.RecordCount" class="form-control form-control-sm" min="1" /></div>
        <div class="col-12 col-md-2"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Xem</button></div>
    </form>
</div></div>

<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Danh sách cơ quan thuế</h6>
        <span class="text-muted small">@Model.TotalCount bản ghi · trang bắt đầu @Model.RecordStart</span>
    </div>
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Mã cơ quan thuế</th>
                <th>Tên cơ quan thuế</th>
                <th>Cấp trên</th>
                <th>Đơn vị nghiệp vụ</th>
                <th>Tỉnh/Huyện</th>
                <th class="text-center">Cấp</th>
                <th>Địa chỉ</th>
                <th>Liên hệ</th>
                <th class="text-center">Trạng thái</th>
                <th>Cập nhật cuối</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="text-muted small">@r.Idx</td>
                <td class="fw-semibold" style="font-family:monospace">@r.GovTaxID</td>
                <td>@r.GovTaxName</td>
                <td class="small" style="font-family:monospace">@(string.IsNullOrEmpty(r.GovTaxIDParent) ? "—" : r.GovTaxIDParent)</td>
                <td class="small" style="font-family:monospace">@(string.IsNullOrEmpty(r.GovTaxIDBUCode) ? "—" : r.GovTaxIDBUCode)</td>
                <td class="small">@(string.IsNullOrEmpty(r.ProvinceCode) ? "—" : r.ProvinceCode)@(string.IsNullOrEmpty(r.DistrictCode) ? "" : "/" + r.DistrictCode)</td>
                <td class="text-center small">@(string.IsNullOrEmpty(r.Level) ? "—" : r.Level)</td>
                <td class="small text-muted">@(string.IsNullOrEmpty(r.Address) ? "—" : r.Address)</td>
                <td class="small">@(string.IsNullOrEmpty(r.ContactEmail) ? "—" : r.ContactEmail)<div class="text-muted small">@r.ContactPhone</div></td>
                <td class="text-center">
                    @if (r.FlagActive) { <span class="badge" style="background:#059669">Đang hoạt động</span> }
                    else { <span class="badge bg-secondary">Ngừng hoạt động</span> }
                </td>
                <td class="small">@r.LogLUDTimeUTC.ToString("yyyy-MM-dd HH:mm")<div class="text-muted small">@r.LogLUBy</div></td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="11" class="text-center text-muted py-4">Không có cơ quan thuế nào khớp bộ lọc.</td></tr> }
        </tbody>
    </table>
    </div>
    <p class="text-muted small mb-0 mt-2">
        <i class="bi bi-info-circle me-1"></i>Endpoint tổng hợp: trả về danh mục cơ quan thuế (Mst_GovTaxID), có phân trang + lọc theo mã cơ quan thuế / tên / mạng-đại lý / tỉnh / trạng thái.
    </p>
</div></div>
