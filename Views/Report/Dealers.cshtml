@model MstDealerListResult
@{ ViewData["Title"] = "Danh sách đại lý"; }
<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-shop me-1"></i>Danh sách đại lý (RptSv_Mst_Dealer)</h6>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mã đại lý (DLCode)</label><input name="dlCode" value="@ViewBag.DLCode" class="form-control form-control-sm" placeholder="VD: DL001" /></div>
        <div class="col-6 col-md-3"><label class="form-label small mb-1">Tên đại lý</label><input name="dlName" value="@ViewBag.DLName" class="form-control form-control-sm" placeholder="Tìm theo tên" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mã tỉnh</label><input name="provinceCode" value="@ViewBag.ProvinceCode" class="form-control form-control-sm" placeholder="VD: 01" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Loại đại lý</label><input name="dlType" value="@ViewBag.DLType" class="form-control form-control-sm" placeholder="VD: CAP2" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Trạng thái</label>
            <select name="flagActive" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.FlagActive as string))">Tất cả</option>
                <option value="1" selected="@(ViewBag.FlagActive == "1")">Đang hoạt động</option>
                <option value="0" selected="@(ViewBag.FlagActive == "0")">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-6 col-md-1"><label class="form-label small mb-1">Số/trang</label><input type="number" name="recordCount" value="@ViewBag.RecordCount" class="form-control form-control-sm" min="1" /></div>
        <div class="col-12 col-md-2"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Xem</button></div>
    </form>
</div></div>

<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Danh sách đại lý</h6>
        <span class="text-muted small">@Model.TotalCount bản ghi · trang bắt đầu @Model.RecordStart</span>
    </div>
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Mã đại lý</th>
                <th>Tên đại lý</th>
                <th>Cấp</th>
                <th>Loại</th>
                <th>Mã cấp trên</th>
                <th>Tỉnh</th>
                <th>Người đại diện</th>
                <th>Điện thoại</th>
                <th class="text-center">SLKH</th>
                <th class="text-center">Trạng thái</th>
                <th>Cập nhật cuối</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="text-muted small">@r.Idx</td>
                <td class="fw-semibold" style="font-family:monospace">@r.DLCode</td>
                <td>@r.DLName</td>
                <td class="small">@(string.IsNullOrEmpty(r.DLLevel) ? "—" : r.DLLevel)</td>
                <td class="small">@(string.IsNullOrEmpty(r.DLType) ? "—" : r.DLType)</td>
                <td class="small" style="font-family:monospace">@(string.IsNullOrEmpty(r.DLCodeParent) ? "—" : r.DLCodeParent)</td>
                <td class="small">@(string.IsNullOrEmpty(r.ProvinceName) ? r.ProvinceCode : $"{r.ProvinceName} ({r.ProvinceCode})")</td>
                <td class="small">@(string.IsNullOrEmpty(r.DLPresentBy) ? "—" : r.DLPresentBy)</td>
                <td class="small">@(string.IsNullOrEmpty(r.DLPhoneNo) ? "—" : r.DLPhoneNo)</td>
                <td class="text-center fw-semibold">@r.CountMST</td>
                <td class="text-center">
                    @if (r.FlagActive) { <span class="badge" style="background:#059669">Đang hoạt động</span> }
                    else { <span class="badge bg-secondary">Ngừng hoạt động</span> }
                </td>
                <td class="small">@r.LogLUDTimeUTC.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="12" class="text-center text-muted py-4">Không có đại lý nào khớp bộ lọc.</td></tr> }
        </tbody>
    </table>
    </div>
    <p class="text-muted small mb-0 mt-2">
        <i class="bi bi-info-circle me-1"></i>Endpoint tổng hợp: trả về danh sách đại lý (Mst_Dealer) kèm tên tỉnh (Mst_Province) và số khách hàng/NNT gắn với đại lý (SLKH = count_MST), có phân trang + lọc theo mã đại lý / tên / tỉnh / loại / trạng thái.
    </p>
</div></div>
