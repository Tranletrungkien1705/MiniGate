@model SysModuleListResult
@{ ViewData["Title"] = "Danh sách mô-đun hệ thống"; }
<div class="card mb-3"><div class="card-body">
    <h6 class="fw-bold mb-3"><i class="bi bi-boxes me-1"></i>Danh sách mô-đun hệ thống (RptSv_Sys_Modules)</h6>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mã mô-đun (ModuleCode)</label><input name="moduleCode" value="@ViewBag.ModuleCode" class="form-control form-control-sm" placeholder="VD: MOD_INVOICE" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mã giải pháp (SolutionCode)</label><input name="solutionCode" value="@ViewBag.SolutionCode" class="form-control form-control-sm" placeholder="VD: SOL_HDDT" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Mạng/đại lý (NetworkID)</label><input name="networkId" value="@ViewBag.NetworkID" class="form-control form-control-sm" placeholder="VD: NET-DEMO" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-1">Trạng thái</label>
            <select name="flagActive" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.FlagActive as string))">Tất cả</option>
                <option value="1" selected="@(ViewBag.FlagActive == "1")">Đang hoạt động</option>
                <option value="0" selected="@(ViewBag.FlagActive == "0")">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-6 col-md-1"><label class="form-label small mb-1">Số/trang</label><input type="number" name="recordCount" value="@ViewBag.RecordCount" class="form-control form-control-sm" min="1" /></div>
        <div class="col-12 col-md-2"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Xem</button></div>
    </form>
</div></div>

<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Danh sách mô-đun hệ thống</h6>
        <span class="text-muted small">@Model.TotalCount bản ghi · trang bắt đầu @Model.RecordStart</span>
    </div>
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Mã mô-đun</th>
                <th>Tên mô-đun</th>
                <th>Giải pháp</th>
                <th>Mạng/đại lý</th>
                <th class="text-end">Hạn mức HĐ</th>
                <th class="text-end">Dung lượng</th>
                <th class="text-center">Trạng thái</th>
                <th>Cập nhật cuối</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="text-muted small">@r.Idx</td>
                <td class="fw-semibold" style="font-family:monospace">@r.ModuleCode</td>
                <td>@r.ModuleName<div class="text-muted small">@r.Description</div></td>
                <td class="small">@(string.IsNullOrEmpty(r.SolutionCode) ? "—" : r.SolutionCode)<div class="text-muted small">@r.SolutionName</div></td>
                <td class="small">@(string.IsNullOrEmpty(r.NetworkID) ? "—" : r.NetworkID)</td>
                <td class="text-end">@r.QtyInvoice.ToString("N0")</td>
                <td class="text-end">@r.ValCapacity.ToString("N2")</td>
                <td class="text-center">
                    @if (r.FlagActive) { <span class="badge" style="background:#059669">Đang hoạt động</span> }
                    else { <span class="badge bg-secondary">Ngừng hoạt động</span> }
                </td>
                <td class="small">@r.LogLUDTimeUTC.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">Không có mô-đun nào khớp bộ lọc.</td></tr> }
        </tbody>
    </table>
    </div>
    <p class="text-muted small mb-0 mt-2">
        <i class="bi bi-info-circle me-1"></i>Endpoint tổng hợp: trả về danh mục mô-đun hệ thống (Sys_Modules) kèm thông tin giải pháp (Sys_Solution), có phân trang + lọc theo mã mô-đun / mã giải pháp / mạng-đại lý / trạng thái.
    </p>
</div></div>
