@model List<RequestLog>
@{ ViewData["Title"] = "Nhật ký request"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">150 request gần nhất qua cổng</h6>
        <a href="/Log" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-clockwise me-1"></i>Làm mới</a>
    </div>
    <table class="table table-sm table-hover align-middle">
        <thead><tr><th>Thời gian</th><th>Client</th><th>Method</th><th>Đường dẫn</th><th>Tuyến</th><th>Status</th><th class="text-end">ms</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            var css = l.StatusCode == 0 ? "dark" : l.StatusCode < 300 ? "success" : l.StatusCode < 400 ? "info" : l.StatusCode < 500 ? "warning" : "danger";
            <tr>
                <td class="small text-muted">@l.At.ToString("HH:mm:ss dd/MM")</td>
                <td class="small">@l.ClientName</td>
                <td><span class="badge bg-light text-dark">@l.Method</span></td>
                <td class="small" style="font-family:monospace">@l.Path</td>
                <td class="small">@l.RouteName</td>
                <td><span class="badge bg-@css">@l.StatusCode</span></td>
                <td class="text-end">@l.LatencyMs</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có request nào qua cổng.</td></tr> }
        </tbody>
    </table>
</div></div>
